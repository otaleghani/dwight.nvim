# Invoke Prompt: flexible AI prompting with tokens
Output invoke-prompt.gif

Set Shell "bash"
Set Theme "Catppuccin Mocha"
Set FontSize 18
Set Padding 20
Set TypingSpeed 60ms
Set WindowBar Colorful
Set Width 1200
Set Height 800

Type "cd sample-project && nvim http.lua"
Enter
Sleep 1.5s

Type "15G"
Sleep 500ms
Type "V10j"
Sleep 800ms

Type ":DwightInvoke"
Sleep 800ms
Enter
Sleep 1.5s

Type "/mode refactor"
Sleep 1s

Escape
Sleep 500ms

Type ":DwightInvoke"
Sleep 800ms
Enter
Sleep 1.5s

Type "$feature "
Sleep 800ms

Tab
Sleep 1.5s

Sleep 2s

Escape
Sleep 500ms
Escape
Sleep 3s
